@model IEnumerable<DoctorVM>
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MedCare Connect - @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-blue: #0078D4;
            --secondary-blue: #0056b3;
            --accent-green: #28a745;
            --text-dark: #2c3e50;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(rgba(255,255,255,0.95), rgba(255,255,255,0.92)),
                        url('https://th.bing.com/th?id=OIP.M2PFitxNtbkPsHJkpyihvQHaEK&w=333&h=187&c=8&rs=1&qlt=90&o=6&pid=3.1&rm=2');
            background-size: cover;
            background-position: center;
            min-height: 100vh;
        }

        .content-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .hero-section {
            padding: 20px 5%;
            text-align: center;
            background: rgba(255,255,255,0.95);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            margin-top: 40px;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('https://www.freepnglogos.com/uploads/medical-logo-png-5.png') no-repeat center center/contain;
            opacity: 0.05;
            z-index: 1;
        }

        .hero-title {
            font-size: 2.8rem;
            margin-bottom: 1.5rem;
            color: var(--text-dark);
            position: relative;
            z-index: 2;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            color: #666;
            margin-bottom: 2rem;
            position: relative;
            z-index: 2;
        }

        .phone-cta {
            display: inline-flex;
            align-items: center;
            padding: 12px 25px;
            background: var(--primary-blue);
            color: white;
            border-radius: 30px;
            text-decoration: none;
            transition: all 0.3s ease;
            margin-bottom: 40px;
            position: relative;
            z-index: 2;
        }

        .phone-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,120,212,0.3);
        }

        .phone-icon {
            margin-right: 10px;
            font-size: 1.2rem;
        }

        .search-section {
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            position: relative;
            z-index: 2;
        }

        .appointment-heading {
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .search-form {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            align-items: end;
        }

        .dropdown-container {
            position: relative;
        }

        .dropdown-label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-dark);
            font-weight: 500;
        }

        .dropdown {
            width: 100%;
            padding: 14px 20px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            background: white;
            appearance: none;
            font-size: 1rem;
            transition: all 0.3s ease;
            padding-right: 45px;
        }

        .dropdown:focus {
            border-color: var(--primary-blue);
            outline: none;
            box-shadow: 0 0 0 3px rgba(0,120,212,0.1);
        }

        .select-icon {
            position: absolute;
            right: 15px;
            bottom: 14px;
            color: #666;
            pointer-events: none;
        }

        .search-button {
            background: linear-gradient(135deg, var(--primary-blue), var(--secondary-blue));
            color: white;
            border: none;
            padding: 14px 30px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .search-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,120,212,0.3);
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            margin-top: 40px;
            padding: 20px;
        }

        .feature-card {
            text-align: center;
            padding: 25px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .feature-icon {
            font-size: 2rem;
            color: var(--primary-blue);
            margin-bottom: 15px;
        }

       {
            .hero-title {
                font-size: 2rem;
            }

            .search-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="content-container">
        <section class="hero-section">
            <h1 class="hero-title">
                <i class="fas fa-heartbeat" style="color: var(--primary-blue); margin-right: 15px;"></i>
                Better Healthcare for Better Lives
            </h1>

            <a href="tel:16676" class="phone-cta">
                <i class="fas fa-phone-alt phone-icon"></i>
                24/7 Emergency: 16676
            </a>

            <div class="search-section">
                <h2 class="appointment-heading">
                    <i class="fas fa-calendar-check"></i>
                    Book Appointment
                </h2>

                <form asp-controller="Doctor" asp-action="SearchFor" method="get" class="search-form">
                    <div class="dropdown-container">
                        <label class="dropdown-label"><i class="fas fa-stethoscope"></i> Specialty</label>
                        <select class="dropdown" name="Specialty">
                            <option value="" disabled selected>Choose Specialty</option>
                            @foreach (var item in Model.Select(d => d.Specialty).Distinct())
                            {
                                    <option value="@item">@item</option>
                            }
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>

                    <div class="dropdown-container">
                        <label class="dropdown-label"><i class="fas fa-map-marker-alt"></i> Location</label>
                        <select class="dropdown" name="City">
                            <option value="" disabled selected>Select City</option>
                            @foreach (var item in Model.Select(d => d.City).Distinct())
                            {
                                    <option value="@item">@item</option>
                            }
                        </select>
                        <i class="fas fa-chevron-down select-icon"></i>
                    </div>

                    <button type="submit" class="search-button">
                        <i class="fas fa-search"></i>
                        Find Doctors
                    </button>
                </form>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <i class="fas fa-clock feature-icon"></i>
                    <h3>Instant Confirmation</h3>
                    <p>Real-time appointment scheduling</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-user-md feature-icon"></i>
                    <h3>Expert Doctors</h3>
                    <p>Qualified medical professionals</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-shield-alt feature-icon"></i>
                    <h3>Safe & Secure</h3>
                    <p>HIPAA compliant platform</p>
                </div>
            </div>
        </section>
    </div>
</body>
</html>