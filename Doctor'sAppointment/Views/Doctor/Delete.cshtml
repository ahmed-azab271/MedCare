
 @model DoctorVM

@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 p-4">
        <h2 class="text-danger text-center"><i class="fa fa-trash"></i> Delete Doctor</h2>
        <hr />

        <h4 class="text-center text-muted">Are you sure you want to delete this doctor from the system?</h4>

        <div class="row mt-4">
     
            <div class="col-md-3 text-center">
                <img src="~/Files/Image/@Model.ImageName" class="rounded-circle border shadow" height="120" width="120" alt="Doctor Image">
            </div>

   
            <div class="col-md-9">
                <dl class="row">
                    <dt class="col-sm-4 text-primary">Full Name:</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4 text-primary">City:</dt>
                    <dd class="col-sm-8">@Model.City</dd>

                    <dt class="col-sm-4 text-primary">Specialty:</dt>
                    <dd class="col-sm-8">@Model.Specialty</dd>

                    <dt class="col-sm-4 text-primary">Fees:</dt>
                    <dd class="col-sm-8"><i class="fa fa-money-bill-wave text-success"></i> @Model.Fees EGP</dd>

                    <dt class="col-sm-4 text-primary">Experience Years:</dt>
                    <dd class="col-sm-8"><i class="fa fa-briefcase text-warning"></i> @Model.ExperinceYears years</dd>

                    <dt class="col-sm-4 text-primary">Resume:</dt>
                    <dd class="col-sm-8">@Model.Resume</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" class="mt-4 text-center">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageName" />
            <input type="hidden" asp-for="Image" />

            <button type="submit" class="btn btn-danger px-4">
                <i class="fa fa-trash-alt"></i> Confirm Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
        </form>
    </div>
</div>
