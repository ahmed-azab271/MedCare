@model IEnumerable<DoctorVM>
@{
    ViewData["Title"] = "SearchFor";
}

<div class="container mt-4">
    @foreach (var item in Model)
    {
                    <div class="card shadow-lg border-0 p-4 mb-4">
                        <div class="row">

                            <div class="col-md-2 text-center">
                                <img src="~/Files/Image/@item.ImageName" class="rounded-circle" height="100" width="100" alt="Doctor Image">
                            </div>


                            <div class="col-md-6">
                                <h4 class="text-primary">Dr. @item.FullName</h4>

                                <p><strong>@item.Specialty</strong> </p>


                                <p><i class="fa fa-map-marker-alt text-danger"></i> @item.City</p>


                                <p><i class="fa fa-money-bill-wave text-success"></i> Fees: @item.Fees EGP</p>
                                 <p><i class="fa fa-briefcase text-primary"></i> Experience: @item.ExperinceYears years</p>


                                <p class="text-success"><i class="fa fa-clock"></i> Waiting Time: 30 Minutes</p>


                                <p><i class="fa fa-phone-alt"></i> 16676 - Cost of a regular call</p>
                            </div>

                            <div class="col-md-4">
                                    <span class="text-success font-weight-bold">Booked At </span>
                    @if (item.DoctorSchedules.Any())
                    {
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Day</th>
                                            <th>At</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                @foreach (var schedule in item.DoctorSchedules)
                                {
                                                <tr>
                                                        <td>@schedule.Day</td>
                                                        <td>@schedule.StartAt.ToString("hh:mm tt")</td>
                                                </tr>
                                }
                                                                    </tbody>
                                                                </table>
                                                    <a href="/DoctorSchedule/Create/@item.Id" class="btn btn-danger btn-block mt-2">Create an Appointment</a>
                    }
                    else
                    {
                                                <span class="text-success font-weight-bold">Free Right Now</span>
                                                <a href="/DoctorSchedule/Create" class="btn btn-danger btn-block mt-2">Create an Appointment</a>
                    }
                    </div>
                                </div>
                            </div>
    }
</div>
