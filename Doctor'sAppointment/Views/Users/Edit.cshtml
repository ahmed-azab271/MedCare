@model UsersVM
@{
    ViewData["Title"] = "Edit User";
}

<div class="container py-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white py-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-user-edit fa-2x me-3"></i>
                <div>
                    <h2 class="h4 mb-0">Edit User Profile</h2>
                    <p class="small mb-0">Update user information and permissions</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Please correct the following errors:</strong>
                </div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OldRole" />

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="FullName" class="form-control" placeholder=" " required />
                            <label asp-for="FullName">
                                <i class="fas fa-user me-2 text-primary"></i>Full Name
                            </label>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="PhoneNumber" class="form-control" placeholder=" " />
                            <label asp-for="PhoneNumber">
                                <i class="fas fa-phone me-2 text-primary"></i>Phone Number
                            </label>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating">
                            <input asp-for="Address" class="form-control" placeholder=" " />
                            <label asp-for="Address">
                                <i class="fas fa-map-marker-alt me-2 text-primary"></i>Address
                            </label>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="Role" class="form-select" required>
                                <option value="">Select Role</option>
                                <option value="Admin">Admin</option>
                                <option value="Doctors">Doctor</option>
                                <option value="Patients">Patient</option>
                            </select>
                            <label asp-for="Role">
                                <i class="fas fa-user-tag me-2 text-primary"></i>User Role
                            </label>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between pt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

        <style>
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card {
                border-radius: 12px;
                overflow: hidden;
                border: none;
            }

            .bg-gradient-primary {
                background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            }

            .form-floating {
                position: relative;
                margin-bottom: 1rem;
            }

            .form-control, .form-select {
                padding: 1rem 1.25rem;
                font-size: 1rem;
                height: calc(3.5rem + 2px);
            }

            .form-control:focus, .form-select:focus {
                box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
                border-color: #4e73df;
            }

            .form-label {
                display: flex;
                align-items: center;
            }

            .btn-primary {
                background-color: #4e73df;
                border-color: #4e73df;
                transition: all 0.3s ease;
            }

            .btn-primary:hover {
                background-color: #3a5ccc;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(78, 115, 223, 0.3);
            }

            .btn-outline-secondary:hover {
                background-color: #f8f9fa;
            }

            .alert-danger {
                border-left: 4px solid #e74a3b;
            }

            .form-select {
                background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
                background-position: right 1rem center;
                background-size: 16px 12px;
            }
        </style>

 
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


@section Scripts {
        <script>
         
            (function () {
                'use strict'

                var forms = document.querySelectorAll('.needs-validation')

                Array.prototype.slice.call(forms)
                    .forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault()
                                event.stopPropagation()
                            }

                            form.classList.add('was-validated')
                        }, false)
                    })
            })()
        </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}