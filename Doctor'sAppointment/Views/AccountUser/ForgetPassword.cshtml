
 @model ForgetPassVM
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4 border-0" style="width: 400px;">
        <h3 class="text-white text-center bg-primary py-2 rounded">Forgot Your Password?</h3>

        <p class="text-center text-muted">No problem. We'll help you recover it</p>

        <form asp-action="SendEmail">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="UserName" class="fw-bold">Enter your UserName to reset your password</label>
                <input asp-for="UserName" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-danger w-100">
                    <i class="fa fa-paper-plane"></i> Send Password
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Login" class="text-primary">Or Back to login page</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
