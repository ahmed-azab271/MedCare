@model AccountUserVM

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 p-4">
        <h2 class="text-primary text-center">Sign Up</h2>
        <p class="text-center text-muted">Create your account to book appointments easily.</p>
        <hr />

       

       

        <form asp-action="Register">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="fw-bold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="First name and Last name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Address" class="fw-bold"></label>
                        <input asp-for="Address" class="form-control" placeholder="Address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PhoneNumber" class="fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-phone"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Mobile Number" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                 

                   
                </div> 

                <div class="col-md-6"> 
                     <div class="form-group mb-3">
                        <label asp-for="Email" class="fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Password" class="fw-bold"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="********" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PasswordCheck" class="fw-bold"></label>
                        <input asp-for="PasswordCheck" type="password" class="form-control" placeholder="Confirm Password" />
                        <span asp-validation-for="PasswordCheck" class="text-danger"></span>
                    </div>
                </div> 
            </div> 

            <div class="form-group form-check mb-3">
                <input class="form-check-input" asp-for="Agree" />
                <label class="form-check-label"> I agree to the <a href="#">Terms of Use</a></label>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-danger px-4">
                    <i class="fa fa-user-plus"></i> Join Now
                </button>
            </div>

        </form>

        <div class="text-center mt-3">
            <span>Already registered?</span> <a asp-action="Login" class="text-primary">Login</a>
        </div>
         <div class="text-center mb-3">
            <span class="text-muted">or</span>
        </div>
         <div class="text-center mb-3">
            <button class="btn btn-primary">
                <i class="fa fa-facebook"></i> Connect with Facebook
            </button>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
