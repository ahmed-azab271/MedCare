
@{
    ViewData["Title"] = "Forget Password";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: Arial, sans-serif;
    }

    .main-agileinfo {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .agileits-top {
        background: #ffffff;
        padding: 30px;
        text-align: center;
        border-radius: 10px;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        width: 400px;
    }

    .body {
        font-size: 16px;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    .btn-primary {
        background: #d9534f;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        color: white;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
        display: inline-block;
    }

    .btn-primary:hover {
        background: #c9302c;
    }
</style>

<div class="main-agileinfo">
    <div class="agileits-top">
        <div class="body">
            ✅ Password Reset Link Has Been Sent To Your Email. Please Check Your Inbox.
        </div>
        <a href="https://mail.google.com/mail/u/0/#inbox" class="btn-primary" target="_blank">Go To Your Inbox</a>
    </div>
</div>
