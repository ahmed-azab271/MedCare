@model IEnumerable<RoleVM>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container-fluid py-4">
    <div class="card shadow-lg">
        <div class="card-header bg-gradient-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="fas fa-user-shield fa-2x me-3"></i>
                    <div>
                        <h2 class="h4 mb-0">Role Management</h2>
                        <p class="small mb-0">Manage system roles and permissions</p>
                    </div>
                </div>
                <img src="/images/security-logo-white.png" alt="Security Logo" style="height: 30px;">
            </div>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-action="Create" class="btn btn-success">
                    <i class="fas fa-plus-circle me-2"></i>Create New Role
                </a>

                <form class="d-flex" style="max-width: 400px;">

                    
                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input class="form-control" type="text" name="Search" placeholder="Search by role name...">
                        <button type="submit" class="btn btn-info">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                    </div>
                </form>
            </div>

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        <i class="fas fa-fingerprint me-2"></i>@Html.DisplayNameFor(model => model.Id)
                                    </th>
                                    <th>
                                        <i class="fas fa-tag me-2"></i>@Html.DisplayNameFor(model => model.Name)
                                    </th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model)
                            {
                                        <tr>
                                            <td class="text-muted small">
                                        @Html.DisplayFor(modelItem => item.Id)
                                            </td>
                                            <td>
                                                <span class="badge bg-primary rounded-pill px-3 py-1">
                                            @Html.DisplayFor(modelItem => item.Name)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Details">
                                                        <i class="fas fa-info-circle"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                            }
                            </tbody>
                        </table>
                    </div>
            }
            else
            {
                    <div class="alert alert-warning d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                        <div>
                            <h5 class="alert-heading">No Roles Found</h5>
                            <p class="mb-0">There are currently no roles in the system. Create your first role to get started.</p>
                        </div>
                    </div>
            }
        </div>
    </div>
</div>


        <style>
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card {
                border-radius: 12px;
                border: none;
                overflow: hidden;
            }

            .bg-gradient-primary {
                background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            }

            .table th {
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.5px;
                color: #6c757d;
                border-top: none;
            }

            .table td {
                vertical-align: middle;
            }

            .table-hover tbody tr:hover {
                background-color: rgba(78, 115, 223, 0.05);
            }

            .btn-group .btn {
                border-radius: 4px !important;
                margin-right: 4px;
            }

            .btn-group .btn:last-child {
                margin-right: 0;
            }

            .badge {
                font-weight: 500;
                font-size: 0.85rem;
                padding: 0.35em 0.65em;
            }

            .alert-warning {
                border-left: 4px solid #f6c23e;
            }

            .input-group-text {
                transition: all 0.3s ease;
            }

            .form-control:focus + .input-group-text {
                color: #4e73df;
                background-color: #e0e6ff;
            }
        </style>


        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

@section Scripts {
        <script>
  
            $(function () {
                $('[title]').tooltip({
                    placement: 'top',
                    trigger: 'hover'
                });
            });
        </script>
}