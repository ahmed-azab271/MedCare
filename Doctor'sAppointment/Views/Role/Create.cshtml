@model RoleVM
@{
    ViewData["Title"] = "Create New Role";
}

<div class="container py-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white py-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-user-plus fa-2x me-3"></i>
                <div>
                    <h2 class="h4 mb-0">Create New Role</h2>
                    <p class="small mb-0">Add a new system role to your application</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" class="needs-validation" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Please correct the following errors:</strong>
                </div>

                <div class="mb-4">
                    <div class="form-floating">
                        <input asp-for="Name" class="form-control form-control-lg" placeholder=" " required />
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-tag me-2 text-primary"></i>Role Name
                        </label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="invalid-feedback">
                            Please provide a valid role name
                        </div>
                    </div>
                    <small class="form-text text-muted mt-2">
                        <i class="fas fa-info-circle me-1"></i> Use a descriptive name (e.g., "Admin", "Manager", "Editor")
                    </small>
                </div>

                <div class="d-flex justify-content-between pt-4 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary px-4 btn-create">
                        <i class="fas fa-plus-circle me-2"></i>Create Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


        <style>
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card {
                border-radius: 12px;
                overflow: hidden;
                border: none;
            }

            .bg-gradient-primary {
                background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            }

            .form-floating {
                position: relative;
            }

            .form-control-lg {
                padding: 1rem 1.25rem;
                font-size: 1.05rem;
                height: calc(3.5rem + 2px);
            }

            .form-control:focus {
                box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.25);
                border-color: #4e73df;
            }

            .form-label {
                display: flex;
                align-items: center;
            }

            .btn-create {
                background-color: #4e73df;
                border-color: #4e73df;
                transition: all 0.3s ease;
            }

            .btn-create:hover {
                background-color: #3a5ccc;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(78, 115, 223, 0.3);
            }

            .btn-outline-secondary:hover {
                background-color: #f8f9fa;
            }

            .alert-danger {
                border-left: 4px solid #e74a3b;
            }
        </style>

       
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


@section Scripts {
        <script>
 
            (function () {
                'use strict'

                var forms = document.querySelectorAll('.needs-validation')

                Array.prototype.slice.call(forms)
                    .forEach(function (form) {
                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault()
                                event.stopPropagation()
                            }

                            form.classList.add('was-validated')
                        }, false)
                    })
            })()
        </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}