@model IEnumerable<DoctorScheduleVM>

@{
    ViewData["Title"] = "Doctor Schedules";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="fas fa-calendar-alt fa-2x me-3"></i>
                <div>
                    <h2 class="h4 mb-0">Doctor Schedules</h2>
                    <p class="small mb-0">Manage working hours and availability</p>
                </div>
            </div>
            <div>
                <img src="/images/medical-logo-white.png" alt="Clinic Logo" style="height: 30px; filter: brightness(0) invert(1);">
            </div>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                @if (Model.Any())
                {
                        <a asp-action="Create" asp-route-id="@ViewBag.DoctorId" class="btn btn-success">
                            <i class="fas fa-plus-circle me-2"></i>Add New Schedule
                        </a>
                }
                else
                {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>No schedules available for this doctor.
                        </div>
                        <a asp-action="Create" asp-route-id="@ViewBag.DoctorId" class="btn btn-success">
                            <i class="fas fa-plus-circle me-2"></i>Create First Schedule
                        </a>
                }
            </div>

            @if (Model.Any())
            {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        <i class="far fa-calendar me-2"></i>@Html.DisplayNameFor(model => model.Day)
                                    </th>
                                    <th>
                                        <i class="far fa-clock me-2"></i>@Html.DisplayNameFor(model => model.StartAt)
                                    </th>
                                    <th>
                                        <i class="far fa-clock me-2"></i>@Html.DisplayNameFor(model => model.EndAt)
                                    </th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model)
                            {
                                        <tr>
                                            <td class="align-middle">
                                                <span class="badge bg-primary rounded-pill px-3 py-1">
                                            @Html.DisplayFor(modelItem => item.Day)
                                                </span>
                                            </td>
                                            <td class="align-middle">
                                                <span class="text-muted">
                                                    <i class="far fa-clock me-1"></i>
                                            @Html.DisplayFor(modelItem => item.StartAt)
                                                </span>
                                            </td>
                                            <td class="align-middle">
                                                <span class="text-muted">
                                                    <i class="far fa-clock me-1"></i>
                                            @Html.DisplayFor(modelItem => item.EndAt)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                   
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                            }
                            </tbody>
                        </table>
                    </div>
            }
        </div>
    </div>
</div>

        <style>
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card {
                border-radius: 10px;
                border: none;
                overflow: hidden;
                box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
            }

            .card-header {
                padding: 1.25rem 1.5rem;
            }

            .table th {
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.5px;
                color: #6c757d;
                border-top: none;
            }

            .table td {
                vertical-align: middle;
            }

            .table-hover tbody tr:hover {
                background-color: rgba(13, 110, 253, 0.05);
                transition: background-color 0.2s ease;
            }

            .btn-group .btn {
                border-radius: 4px !important;
                margin-right: 4px;
            }

            .btn-group .btn:last-child {
                margin-right: 0;
            }

            .badge {
                font-weight: 500;
                font-size: 0.8rem;
            }

            .table-striped tbody tr:nth-of-type(odd) {
                background-color: rgba(0, 0, 0, 0.01);
            }
        </style>

      
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


@section Scripts {
        <script>

            $(function () {
                $('[title]').tooltip({
                    placement: 'top',
                    trigger: 'hover'
                });
            });
        </script>
}