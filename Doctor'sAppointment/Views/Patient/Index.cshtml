 @model PatientVM
@{
    ViewData["Title"] = "Patient Dashboard";
}

@if (Model == null)
{
        <div class="container text-center mt-5">
            <div class="alert alert-warning p-5 rounded-4 shadow-lg">
                <i class="fas fa-exclamation-triangle fa-4x mb-4 text-warning"></i>
                <h2 class="mb-3 fw-bold">Account Required</h2>
                <p class="lead fs-4">Access to patient features requires authentication</p>
                <div class="mt-4">
                    <a href="@Url.Action("Login", "AccountUser")" class="btn btn-primary btn-lg px-5 py-3">
                        <i class="fas fa-sign-in-alt me-2"></i>Login to Continue
                    </a>
                </div>
            </div>
        </div>
}
else
{
        <div class="container patient-profile">
          
            <div class="profile-header text-center mb-5 p-4 bg-gradient-primary text-white rounded-4 shadow-lg">
                <div class="avatar-container mb-3">
                    <i class="fas fa-user-circle fa-4x text-white"></i>
                @if (User.IsInRole("Admin"))
                {
                            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
                                ADMIN VIEW
                            </span>
                }
                </div>
                <h1 class="display-4 fw-bold mb-3">@Model.FullName's Dashboard</h1>
            @if (User.IsInRole("Admin"))
            {
                        <div class="admin-info">
                            <p class="mb-0">Patient ID: @Model.Id</p>
                            <p class="mb-0">Last Login: @DateTime.Now.ToString("g")</p>
                        </div>
            }
            </div>
        @if (User.IsInRole("Patients") || User.IsInRole("Admin"))
        {
          
            <div class="row mb-5">
                <div class="col-12">
                @if (Model.DoctorSchedules.Any())
                {
                            <div class="card shadow-lg border-0">
                                <div class="card-header bg-primary text-white py-3 rounded-top">
                                    <h4 class="mb-0">
                                        <i class="fas fa-calendar-check me-2"></i>Upcoming Appointments
                                    </h4>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th class="ps-4"><i class="fas fa-calendar-day me-2"></i>Date</th>
                                                    <th><i class="fas fa-clock me-2"></i>Time</th>
                                                    <th class="ps-4"><i class="fas fa-user-md me-2"></i>Physician</th>
                                                    <th class="pe-4 text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                        @foreach (var schedule in Model.DoctorSchedules)
                                        {
                                                        <tr class="hover-highlight">
                                                            <td class="ps-4 fw-bold">@schedule.Day</td>
                                                            <td>@schedule.StartAt.ToString("hh:mm tt")</td>
                                                            <td class="ps-4">
                                                                <div class="d-flex align-items-center">
                                                                    <i class="fas fa-user-md me-2 text-primary"></i>
                                                                    Dr. @Model.DoctorModel.FullName
                                                                </div>
                                                            </td>
                                                            <td class="pe-4 text-end">
                                                                <button class="btn btn-sm btn-outline-primary">
                                                                    <a asp-controller="DoctorSchedule" asp-action="Edit" asp-route-id="@schedule.Id">
                                                                    <i class="fas fa-edit"></i> Reschedule
                                                                    </a>
                                                                </button>
                                                            </td>
                                                        </tr>
                                        }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                }
                else
                {
                            <div class="card shadow-lg border-0 text-center py-5">
                                <div class="card-body">
                                    <i class="fas fa-calendar-times fa-4x text-muted mb-4"></i>
                                    <h3 class="text-muted mb-3">No Scheduled Appointments</h3>
                                    <p class="text-muted mb-4">Book your next appointment with your physician</p>
                                    <a href="#" class="btn btn-primary px-5">
                                        <i class="fas fa-plus-circle me-2"></i>Schedule Appointment
                                    </a>
                                </div>
                            </div>
                }
                </div>
            </div>
            }

          
            <div class="row g-4">
             
                <div class="col-lg-6">
                    <div class="card h-100 shadow-lg border-0 hover-transform">
                        <div class="card-body p-4 text-center">
                            <div class="icon-container bg-primary-light mb-4">
                                <i class="fas fa-notes-medical fa-3x text-primary"></i>
                            </div>
                            <h3 class="mb-3">Symptom Checker</h3>
                            <p class="text-muted mb-4">Track and report your current symptoms for better diagnosis</p>
                            <a asp-action="Symptoms" asp-route-id="@Model.Id" 
                               class="btn btn-primary px-5 py-2">
                                <i class="fas fa-stethoscope me-2"></i>Begin Assessment
                            </a>
                        </div>
                    </div>
                </div>

             
                <div class="col-lg-6">
                    <div class="card h-100 shadow-lg border-0 hover-transform">
                        <div class="card-body p-4 text-center">
                            <div class="icon-container bg-success-light mb-4">
                                <i class="fas fa-file-medical fa-3x text-success"></i>
                            </div>
                            <h3 class="mb-3">Health Records</h3>
                            <p class="text-muted mb-4">Access your complete medical history and documents</p>
                            <a asp-action="MedicalRecords" asp-route-id="@Model.Id" 
                               class="btn btn-success px-5 py-2">
                                <i class="fas fa-folder-open me-2"></i>View Records
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
}

<style>
    .patient-profile {
        padding: 2rem 0;
        min-height: 80vh;
    }

    .profile-header {
        background: linear-gradient(135deg, #0078D4 0%, #004578 100%);
        padding: 3rem 2rem;
        position: relative;
        overflow: hidden;
    }

    .profile-header::after {
        content: "";
        position: absolute;
        bottom: -50px;
        left: 0;
        right: 0;
        height: 100px;
        background: white;
        transform: skewY(-3deg);
    }

    .hover-transform {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hover-transform:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .icon-container {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .bg-primary-light { background-color: rgba(0, 120, 212, 0.1); }
    .bg-success-light { background-color: rgba(40, 167, 69, 0.1); }

    .hover-highlight:hover {
        background-color: rgba(0, 120, 212, 0.03);
        cursor: pointer;
    }

    .table th {
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .btn {
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .avatar-container {
        position: relative;
        display: inline-block;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
        border-radius: 10px;
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}