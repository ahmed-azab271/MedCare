@model Doctor_sAppointment.ViewModels.PatientVM
@{
    ViewData["Title"] = "Edit Medical Records";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-edit me-2"></i>Edit Medical Record - @Model.FullName
            </h3>
        </div>

        <div class="card-body">
            <form asp-action="EditMedicalRecords" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                 <div asp-validation-summary="All" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="Diagnosis" class="form-label">
                                <i class="fas fa-diagnoses me-2"></i>Diagnosis
                            </label>
                            <input asp-for="Diagnosis" class="form-control" placeholder="Enter diagnosis" />
                            <span asp-validation-for="Diagnosis" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-4">
                            <label asp-for="Doctor" class="form-label">
                                <i class="fas fa-user-md me-2"></i>Treating Doctor
                            </label>
                            <input asp-for="Doctor" class="form-control" placeholder="Doctor's name" />
                            <span asp-validation-for="Doctor" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Treatment" class="form-label">
                        <i class="fas fa-prescription-bottle-alt me-2"></i>Treatment Plan
                    </label>
                    <textarea asp-for="Treatment" class="form-control" rows="4" 
                              placeholder="Describe the treatment plan"></textarea>
                    <span asp-validation-for="Treatment" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Notes" class="form-label">
                        <i class="fas fa-notes-medical me-2"></i>Clinical Notes
                    </label>
                    <textarea asp-for="Notes" class="form-control" rows="3" 
                             placeholder="Additional observations or comments"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="form-group d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Profile
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

        <style>
            .card {
                border-radius: 15px;
                border: none;
            }

            .form-label {
                color: #0078D4;
                font-weight: 500;
            }

            .form-control {
                border: 2px solid #0078D4;
                border-radius: 8px;
                padding: 0.8rem;
            }

            .form-control:focus {
                border-color: #0056b3;
                box-shadow: 0 0 0 0.25rem rgba(0, 120, 212, 0.25);
            }

            .btn-primary {
                background-color: #0078D4;
                border: none;
                padding: 0.8rem 2rem;
                transition: all 0.3s ease;
            }

            .btn-primary:hover {
                background-color: #0056b3;
                transform: translateY(-2px);
            }
        </style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}