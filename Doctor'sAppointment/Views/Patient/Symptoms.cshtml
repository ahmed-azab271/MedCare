 @model PatientVM
@{
    ViewData["Title"] = "Symptoms Report";
}

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="fas fa-notes-medical me-2"></i>Symptoms Report - @Model.FullName
            </h3>
        </div>

        <div class="card-body">
            @if (string.IsNullOrEmpty(Model.Description))
            {
           
                <form asp-action="Symptoms" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="AccountUserId" />

                    <div class="row">
           
                        <div class="col-md-8">
                            <div class="form-group mb-4">
                                <label class="form-label">
                                    <i class="fas fa-comment-medical me-2"></i>Describe your symptoms *
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="5" 
                                placeholder="Example: Headache, fever, and sore throat since yesterday morning..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                                <small class="form-text text-muted">Please be as specific as possible</small>
                            </div>
                        </div>

      
                        <div class="col-md-4">
      
                            <div class="form-group mb-4">
                                <label class="form-label">
                                    <i class="fas fa-thermometer-half me-2"></i>Symptom Severity *
                                </label>
                                <select asp-for="Severity" class="form-select">
                                    <option value="">Select Severity</option>
                                    <option value="Mild">Mild</option>
                                    <option value="Moderate">Moderate</option>
                                    <option value="Severe">Severe</option>
                                    <option value="Emergency">Emergency</option>
                                </select>
                                <span asp-validation-for="Severity" class="text-danger"></span>
                            </div>

         
                            <div class="form-group mb-4">
                                <label class="form-label">
                                    <i class="fas fa-clock me-2"></i>Duration *
                                </label>
                                <input asp-for="Duration" type="text" class="form-control" 
                                placeholder="Example: 2 days, 3 hours">
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>

      
                            <div class="form-group mb-4">
                                <label class="form-label">
                                    <i class="fas fa-plus-circle me-2"></i>Additional Notes
                                </label>
                                <textarea asp-for="AdditionalNotes" class="form-control" rows="3"
                                placeholder="Medications, allergies, etc..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i>Submit Symptoms
                        </button>
                    </div>
                </form>
            }
            else
            {

                <form asp-action="EditSymptoms" method="Get">
                    <input type="hidden" asp-for="FullName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="AccountUserId" />
                    <div class="symptoms-details">
                        <div class="alert alert-success">
                            <h4><i class="fas fa-check-circle me-2"></i>Current Symptoms Report</h4>
                        </div>

                        <dl class="row">
                            <dt class="col-sm-3 text-primary">Symptoms</dt>
                            <dd class="col-sm-9">@Model.Description</dd>

                            <dt class="col-sm-3 text-primary">Severity</dt>
                            <dd class="col-sm-9">@Model.Severity</dd>

                            <dt class="col-sm-3 text-primary">Duration</dt>
                            <dd class="col-sm-9">@Model.Duration</dd>

                            @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
                            {
                                <dt class="col-sm-3 text-primary">Additional Notes</dt>
                                <dd class="col-sm-9">@Model.AdditionalNotes</dd>
                            }
                        </dl>
                        @if (User.IsInRole("Admin") || User.IsInRole("Patients"))
                        {

                            <div class="text-center mt-4">
                                <a asp-action="EditSymptoms" asp-route-id="@Model.Id" 
                                class="btn btn-warning btn-lg">
                                    <i class="fas fa-edit me-2"></i>Update Symptoms
                                </a>
                            </div>
                        }
                    </div>
                    </form>
            }
        </div>
    </div>
</div>

<style>
    .symptoms-details dt {
        font-weight: 600;
        margin-top: 1rem;
    }

    .symptoms-details dd {
        margin-bottom: 0.5rem;
        padding-left: 1rem;
        border-left: 3px solid #0078D4;
    }

    .form-label {
        color: #0078D4;
        font-weight: 500;
    }

    textarea {
        resize: none;
        border: 2px solid #0078D4;
        border-radius: 10px;
        padding: 1rem;
    }

    .form-select {
        border: 2px solid #0078D4;
        border-radius: 8px;
    }

    .btn-primary {
        background-color: #0078D4;
        border: none;
        padding: 0.8rem 2rem;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        transform: translateY(-2px);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

        <script>
      
            $(document).ready(function() {
                const $description = $('#Description');
                const $counter = $('<small class="form-text text-muted float-end"></small>');
                $description.after($counter);

                $description.on('input', function() {
                    const length = $(this).val().length;
                    $counter.text(length + '/500 characters');
                });
            });
        </script>
}